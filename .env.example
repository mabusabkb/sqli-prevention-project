# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Which config to load: development | testing | production
FLASK_ENV=development

# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# SQLAlchemy connection string.
# Development default (set automatically if omitted): sqlite:///dev.db
# Example MySQL: mysql+pymysql://user:password@localhost:3306/sqli_prevention
DATABASE_URL=sqlite:///dev.db

# Port the Flask dev server listens on
PORT=5000
